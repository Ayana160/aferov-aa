<Window x:Class="HelpDesk.Views.TicketEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Редактирование заявки"
        Height="480" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Редактирование заявки" FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Номер заявки:" FontSize="14"/>
        <TextBox x:Name="IdTextBox" Grid.Row="2" IsReadOnly="True" Width="100" HorizontalAlignment="Left" Background="#EEE"/>

        <TextBlock Grid.Row="3" Text="Категория:" FontSize="14" Margin="0,10,0,0"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="4" Width="400" HorizontalAlignment="Left"/>

        <TextBlock Grid.Row="5" Text="Описание:" FontSize="14" Margin="0,10,0,0"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="6" Height="70" Width="400" HorizontalAlignment="Left"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="7" Text="Приоритет:" FontSize="14" Margin="0,10,0,0"/>
        <ComboBox x:Name="PriorityComboBox" Grid.Row="8" Width="200" HorizontalAlignment="Left"/>

        <TextBlock Grid.Row="9" Text="Статус:" FontSize="14" Margin="0,10,0,0"/>
        <ComboBox x:Name="StatusComboBox" Grid.Row="10" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="Сохранить изменения" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
